{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Praetorium",
  "version": "2.2.0",
  "identifier": "com.praetorium.local",
  "build": {
    "frontendDist": "http://localhost:3848"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Praetorium",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:3848 http://localhost:3848; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": ["Korean", "English"],
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 660, "height": 420 },
        "appPosition": { "x": 180, "y": 220 },
        "applicationFolderPosition": { "x": 480, "y": 220 }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../server.js": "./",
      "../index.html": "./",
      "../package.json": "./",
      "../js/owner-console.js": "./js/owner-console.js",
      "../css/owner-console.css": "./css/owner-console.css",
      "../lib/director-service.js": "./lib/director-service.js",
      "../lib/director-actions.js": "./lib/director-actions.js",
      "../lib/candidate-snapshot.js": "./lib/candidate-snapshot.js",
      "../lib/goal-supervisor.js": "./lib/goal-supervisor.js",
      "../lib/hermes-runtime.js": "./lib/hermes-runtime.js",
      "../lib/local-only.js": "./lib/local-only.js",
      "../lib/praetorium-config.js": "./lib/praetorium-config.js",
      "../lib/project-identity.js": "./lib/project-identity.js",
      "../lib/workflow-catalog.js": "./lib/workflow-catalog.js",
      "../lib/wsl-runtime.js": "./lib/wsl-runtime.js",
      "../routes/directors.js": "./routes/directors.js",
      "../scripts/bootstrap-wsl-runtime.mjs": "./scripts/bootstrap-wsl-runtime.mjs",
      "../scripts/patch-hermes-codex-runtime.mjs": "./scripts/patch-hermes-codex-runtime.mjs",
      "../.agents/": "./.agents/"
    }
  }
}
